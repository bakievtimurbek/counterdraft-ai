# CounterDraft AI Environment Variables

# Gemini API Key (Optional: statistical rule-based engine activates automatically if not provided)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenDota API Key (Optional: public OpenDota API tier works without key, key increases rate limits)
OPENDOTA_API_KEY=

# Server Port (default: 3000)
PORT=3000
